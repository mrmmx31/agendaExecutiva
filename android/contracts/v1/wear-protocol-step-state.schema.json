{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenda.local/contracts/v1/wear-protocol-step-state.schema.json",
  "title": "Wear protocol step state",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "run_id", "protocol_id", "revision", "protocol_title", "step_id", "step_label", "step_position", "step_count", "updated_at", "status", "acknowledged_operation_id"],
  "properties": {
    "contract_version": { "const": 1 },
    "run_id": { "type": "string", "format": "uuid" },
    "protocol_id": { "type": "string", "format": "uuid" },
    "revision": { "type": "integer", "minimum": 1 },
    "protocol_title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "step_id": { "type": ["string", "null"], "format": "uuid" },
    "step_label": { "type": ["string", "null"], "minLength": 1, "maxLength": 120 },
    "step_position": { "type": ["integer", "null"], "minimum": 1, "maximum": 100 },
    "step_count": { "type": "integer", "minimum": 1, "maximum": 100 },
    "updated_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["ACTIVE", "COMPLETED"] },
    "acknowledged_operation_id": { "type": ["string", "null"], "format": "uuid" }
  }
}
