{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenda.local/contracts/v1/alert-definition.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "alert_id", "origin", "reference_id", "text", "reason", "source_device_id", "scheduled_at", "valid_until", "criticality", "allowed_channels", "repeat_policy", "actions"],
  "properties": {
    "contract_version": { "const": 1 },
    "alert_id": { "type": "string", "format": "uuid" },
    "origin": { "enum": ["TASK", "PROTOCOL", "MANUAL"] },
    "reference_id": { "type": ["string", "null"], "format": "uuid" },
    "text": { "type": "string", "minLength": 1, "maxLength": 160 },
    "reason": { "type": "string", "minLength": 1, "maxLength": 160 },
    "source_device_id": { "type": "string", "format": "uuid" },
    "scheduled_at": { "type": "string", "format": "date-time" },
    "valid_until": { "type": "string", "format": "date-time" },
    "criticality": { "enum": ["ROUTINE", "IMPORTANT"] },
    "allowed_channels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["VISUAL", "PHONE_VIBRATION", "WEAR_VIBRATION", "AUDIO"] }
    },
    "repeat_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_deliveries", "minimum_interval_minutes"],
      "properties": {
        "max_deliveries": { "type": "integer", "minimum": 1, "maximum": 5 },
        "minimum_interval_minutes": { "type": "integer", "minimum": 5, "maximum": 1440 }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["COMPLETE", "SNOOZE"] }
    }
  }
}
