{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenda.local/contracts/v1/snapshot-page.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshot_id", "server_cursor", "page", "has_more", "next_page_token", "tasks", "protocols"],
  "properties": {
    "snapshot_id": { "type": "string", "format": "uuid" },
    "server_cursor": { "type": "integer", "minimum": 0 },
    "page": { "type": "integer", "minimum": 1 },
    "has_more": { "type": "boolean" },
    "next_page_token": { "type": ["string", "null"], "maxLength": 256 },
    "tasks": { "type": "array", "maxItems": 200, "items": { "type": "object" } },
    "protocols": { "type": "array", "maxItems": 50, "items": { "type": "object" } }
  }
}
