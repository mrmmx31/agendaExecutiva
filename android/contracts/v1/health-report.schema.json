{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenda.local/contracts/v1/health-report.schema.json",
  "title": "Health report snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "snapshot_id", "generated_at", "period_start", "period_end", "time_zone", "subject_label", "selected_categories", "permissions", "sources", "limitations", "excluded_entry_count", "entries"],
  "properties": {
    "contract_version": { "const": 1 },
    "snapshot_id": { "type": "string", "format": "uuid" },
    "generated_at": { "type": "string", "format": "date-time" },
    "period_start": { "type": "string", "format": "date-time" },
    "period_end": { "type": "string", "format": "date-time" },
    "time_zone": { "type": "string", "minLength": 1, "maxLength": 80 },
    "subject_label": { "type": "string", "maxLength": 120 },
    "selected_categories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/category" } },
    "permissions": { "type": "array", "items": { "$ref": "#/$defs/permission" } },
    "sources": { "type": "array", "uniqueItems": true, "items": { "type": "string", "maxLength": 255 } },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "maxLength": 500 } },
    "excluded_entry_count": { "type": "integer", "minimum": 0 },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "category": { "enum": ["HEART_RATE", "RESTING_HEART_RATE", "SLEEP", "ACTIVITY", "MEDICATION", "SUBSTANCE", "SYMPTOM", "ROUTINE_NOTE"] },
    "permission": {
      "type": "object", "additionalProperties": false,
      "required": ["category", "enabled", "foreground_only", "retention_days"],
      "properties": {
        "category": { "$ref": "#/$defs/category" },
        "enabled": { "type": "boolean" },
        "foreground_only": { "type": "boolean" },
        "retention_days": { "type": "integer", "minimum": 1, "maximum": 3650 }
      }
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "category", "start_at", "end_at", "title", "details", "sources"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "kind": { "enum": ["SENSOR_AGGREGATE", "RECORDED_FACT", "USER_OBSERVATION"] },
        "category": { "$ref": "#/$defs/category" },
        "start_at": { "type": "string", "format": "date-time" },
        "end_at": { "type": ["string", "null"], "format": "date-time" },
        "title": { "type": "string", "maxLength": 120 },
        "details": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 2000 } },
        "sources": { "type": "array", "uniqueItems": true, "items": { "type": "string", "maxLength": 255 } }
      }
    }
  }
}
