{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenda.local/contracts/v1/pairing-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "session_id", "desktop_id", "device_id", "device_name", "one_time_code", "device_public_key", "invitation_nonce", "requested_roles"],
  "properties": {
    "contract_version": { "const": 1 },
    "session_id": { "type": "string", "format": "uuid" },
    "desktop_id": { "type": "string", "format": "uuid" },
    "device_id": { "type": "string", "format": "uuid" },
    "device_name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "one_time_code": { "type": "string", "pattern": "^[0-9]{6}$" },
    "device_public_key": { "type": "string", "minLength": 342, "maxLength": 1024 },
    "invitation_nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43,128}$" },
    "requested_roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["TASKS_READ", "CAPTURES_WRITE", "PROTOCOLS_EXECUTE"] } }
  }
}
