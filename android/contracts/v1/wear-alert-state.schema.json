{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenda.local/contracts/v1/wear-alert-state.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "alert_id", "revision", "text", "reason", "source_device_id", "scheduled_at", "valid_until", "updated_at", "criticality", "actions", "snooze_options_minutes", "status", "acknowledged_operation_id"],
  "properties": {
    "contract_version": { "const": 1 },
    "alert_id": { "type": "string", "format": "uuid" },
    "revision": { "type": "integer", "minimum": 1 },
    "text": { "type": "string", "minLength": 1, "maxLength": 160 },
    "reason": { "type": "string", "minLength": 1, "maxLength": 160 },
    "source_device_id": { "type": "string", "format": "uuid" },
    "scheduled_at": { "type": "string", "format": "date-time" },
    "valid_until": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "criticality": { "enum": ["ROUTINE", "IMPORTANT"] },
    "actions": {
      "type": "array",
      "prefixItems": [
        { "const": "COMPLETE" },
        { "const": "SNOOZE" }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "snooze_options_minutes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 5, "maximum": 240 }
    },
    "status": { "enum": ["PENDING", "COMPLETED", "SNOOZED", "CANCELLED", "EXPIRED"] },
    "acknowledged_operation_id": { "type": ["string", "null"], "format": "uuid" }
  }
}
