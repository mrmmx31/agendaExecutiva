{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenda.local/contracts/v1/recommendation-decision.schema.json",
  "title": "Explainable local recommendation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "recommendation_id", "generated_at", "engine_id", "rule_version", "purpose", "sample_count", "minimum_samples", "fallback", "options"],
  "properties": {
    "contract_version": { "const": 1 },
    "recommendation_id": { "type": "string", "format": "uuid" },
    "generated_at": { "type": "string", "format": "date-time" },
    "engine_id": { "enum": ["DETERMINISTIC_RULES", "PERSONAL_LINEAR_MODEL"] },
    "rule_version": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9._-]+$" },
    "purpose": { "enum": ["SNOOZE_PRESET", "ALERT_CHANNEL", "PROTOCOL_SHORTCUT"] },
    "sample_count": { "type": "integer", "minimum": 0 },
    "minimum_samples": { "type": "integer", "minimum": 1 },
    "fallback": { "type": "boolean" },
    "options": {
      "type": "array", "minItems": 1, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["option_code", "rank", "reason_code"],
        "properties": {
          "option_code": { "enum": ["SNOOZE_5", "SNOOZE_10", "SNOOZE_15", "SNOOZE_30", "SNOOZE_60", "CHANNEL_VISUAL", "CHANNEL_AUDIO", "CHANNEL_WATCH", "PROTOCOL_EXIT"] },
          "rank": { "type": "integer", "minimum": 1, "maximum": 3 },
          "reason_code": { "enum": ["CAUTIOUS_DEFAULT", "MANUAL_PREFERENCE", "ENOUGH_LOCAL_HISTORY", "QUIET_HOURS_GUARD", "DEVICE_AVAILABLE", "ACTIVE_PROTOCOL", "DOMAIN_LIMIT_APPLIED", "PERSONAL_MODEL"] }
        }
      }
    }
  }
}
