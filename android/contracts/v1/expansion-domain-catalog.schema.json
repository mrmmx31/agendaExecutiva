{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenda.local/contracts/v1/expansion-domain-catalog.schema.json",
  "title": "Agenda Android expansion domain catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_version", "domains"],
  "properties": {
    "catalog_version": { "const": 1 },
    "domains": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code", "desktop_surface", "mobile_scope", "priority",
          "entities", "commands", "alert_sources", "desktop_only"
        ],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z_]+$" },
          "desktop_surface": { "type": "string", "minLength": 1, "maxLength": 80 },
          "mobile_scope": { "enum": ["COMPLETE", "OPERATIONAL", "READ_ONLY"] },
          "priority": { "enum": ["P0", "P1", "P2"] },
          "entities": { "type": "array", "items": { "type": "string", "pattern": "^[a-z_]+$" }, "uniqueItems": true },
          "commands": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z_]+$" }, "uniqueItems": true },
          "alert_sources": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z_]+$" }, "uniqueItems": true },
          "desktop_only": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    }
  }
}
